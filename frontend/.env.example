# Development: the browser calls the backend directly (CORS).
NEXT_PUBLIC_API_URL=http://localhost:5000

# Production on Vercel: leave NEXT_PUBLIC_API_URL EMPTY and set BACKEND_URL to the backend's address.
# next.config.ts then forwards /api/* to the backend, so the login cookie belongs to the frontend's own domain.
#   NEXT_PUBLIC_API_URL=
#   BACKEND_URL=https://nama-backend.vercel.app
