PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
# Signs the login cookie. Use a long random string. Required when NODE_ENV=production.
SESSION_SECRET=

# Database (MySQL / MariaDB). Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# XAMPP biasanya: user root tanpa sandi. Jalankan "npm run db:migrate" lalu "npm run db:seed" setelah mengisi ini.
DATABASE_URL="mysql://root:@localhost:3306/museum_mpupurwa"

# Cloud storage (Vercel Blob) for collection photos and PDFs.
# Vercel dashboard > Storage > Create Database > Blob (pilih Public) > tab ".env.local" > BLOB_READ_WRITE_TOKEN.
# Leave empty to switch uploads off: POST /api/uploads then answers 503. Never commit the real token.
BLOB_READ_WRITE_TOKEN=
