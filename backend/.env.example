PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
# Signs the login cookie. Use a long random string. Required when NODE_ENV=production.
SESSION_SECRET=

# Database (MySQL / MariaDB). Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# XAMPP biasanya: user root tanpa sandi. Jalankan "npm run db:migrate" lalu "npm run db:seed" setelah mengisi ini.
DATABASE_URL="mysql://root:@localhost:3306/museum_mpupurwa"

# Cloud storage (Vercel Blob) for collection photos and PDFs.
# Vercel dashboard > Storage > Create Database > Blob (pilih Public) > tab ".env.local" > BLOB_READ_WRITE_TOKEN.
# Leave empty to switch uploads off: POST /api/uploads then answers 503. Never commit the real token.
BLOB_READ_WRITE_TOKEN=

# Log level: debug | info | warn | error (default: debug in development, info in production).
LOG_LEVEL=

# Check-in QR (the QR shown on the "Pengunjung Hari Ini" page, scanned by the mobile app).
# CHECKIN_QR_SECRET: signing key. Empty = derived from SESSION_SECRET.
# CHECKIN_QR_REQUIRED: true = POST /api/public/visits without a valid QR is refused. Turn on once the app can scan.
CHECKIN_QR_SECRET=
CHECKIN_QR_REQUIRED=false

# Visitor OTP email (mobile app login). Resend: https://resend.com > API Keys. The sender domain must be verified there.
# Without RESEND_API_KEY: development logs the code (and OTP_DEV_ECHO=true also returns it in the response);
# production refuses with 503, so set it before opening the app to the public.
RESEND_API_KEY=
MAIL_FROM=Museum Mpu Purwa <onboarding@resend.dev>
OTP_DEV_ECHO=true
